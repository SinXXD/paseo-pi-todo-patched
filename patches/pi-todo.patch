+export function mapTodoItemsFromToolResult(result?: PiToolResult): AgentTaskItem[] | null {
+  const details = result && typeof result !== "string" ? result.details : undefined;
+  // 兼容两套结构: pi 内置 todo(details.tasks, subject/status) 与 pi-deck-todo 扩展(details.todos, text/done)
+  const rawTodos = isRecord(details)
+    ? Array.isArray(details.tasks)
+      ? details.tasks
+      : Array.isArray(details.todos)
+        ? details.todos
+        : undefined
+    : undefined;
+  if (!Array.isArray(rawTodos) || rawTodos.length === 0) return null;
+  const items: AgentTaskItem[] = [];
+  for (const raw of rawTodos) {
+    if (!isRecord(raw)) continue;
+    const text = readNonEmptyString(raw.text) ?? readNonEmptyString(raw.subject);
+    if (!text) continue;
+    const done =
+      raw.done === true ||
+      (typeof raw.status === "string" && raw.status === "completed");
+    const id = raw.id !== undefined && raw.id !== null ? String(raw.id) : undefined;
+    items.push({
+      text,
+      ...(id ? { id } : {}),
+      completed: done,
+      status: done ? ("completed" as const) : ("pending" as const),
+    });
+  }
+  return items.length > 0 ? items : null;
+}
